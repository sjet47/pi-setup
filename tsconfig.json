{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "extensions/pi-shots",
    "extensions/pi-stats/src",
    "extensions/pi-execution-time",
    "extensions/pi-fast-mode",
    "extensions/pi-search-prompts",
    "extensions/pi-inline-skill",
    "extensions/pi-wakatime/src",
    "extensions/pi-wakatime/test",
    "extensions/pi-cache-graph",
    "extensions/pi-footer",
    "extensions/pi-wordle"
  ]
}
